<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/user_bg">

    <!-- Top App Bar (Uniform Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/admin_padding"
        android:background="@color/white">

        <ImageView
            android:layout_width="@dimen/admin_topbar_btn_size"
            android:layout_height="@dimen/admin_topbar_btn_size"
            android:padding="@dimen/admin_topbar_btn_padding"
            android:src="@drawable/ic_orders"
            android:background="@drawable/bg_badge_green"
            app:tint="@color/green_primary"
            android:layout_marginEnd="@dimen/admin_topbar_icon_gap_large" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/user_orders_title"
            android:textSize="@dimen/admin_topbar_title_large"
            android:textColor="#222222"
            android:fontFamily="@font/inter_bold" />

        <ImageView
            android:id="@+id/ivNotification"
            android:layout_width="@dimen/admin_topbar_btn_size"
            android:layout_height="@dimen/admin_topbar_btn_size"
            android:padding="@dimen/admin_topbar_btn_padding"
            android:src="@drawable/ic_notification"
            android:background="@drawable/bg_badge_green"
            app:tint="@color/green_primary"
            android:contentDescription="Notifications" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/text_hint" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutUserOrders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingTop="@dimen/admin_section_gap"
        android:paddingBottom="@dimen/admin_dialog_title_gap"
        app:tabMode="scrollable"
        app:tabTextColor="#78909C"
        app:tabSelectedTextColor="#4CAF50"
        app:tabIndicatorColor="#4CAF50"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="@dimen/admin_item_gap_small"
        app:tabRippleColor="@null"
        app:tabTextAppearance="@style/CustomTabTextStyle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUserOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp" />

    <LinearLayout
        android:id="@+id/layoutEmptyOrders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_orders"
            app:tint="#E0E0E0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No orders yet"
            android:textSize="18sp"
            android:fontFamily="@font/inter_bold"
            android:textColor="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Start shopping to see your orders here!"
            android:textSize="14sp"
            android:textColor="@color/text_hint" />

    </LinearLayout>

</LinearLayout>
