<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/admin_padding"
        android:background="@color/white">

        <ImageView
            android:layout_width="@dimen/admin_topbar_btn_size"
            android:layout_height="@dimen/admin_topbar_btn_size"
            android:padding="@dimen/admin_topbar_btn_padding"
            android:src="@drawable/ic_overview"
            android:background="@drawable/bg_badge_green"
            android:contentDescription="Menu"
            app:tint="#2E7D32"
            android:layout_marginEnd="@dimen/admin_topbar_icon_gap_large" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Overview"
            android:textSize="@dimen/admin_topbar_title_large"
            android:textStyle="bold"
            android:textColor="#222222" />

        <ImageView
            android:id="@+id/btnNotification"
            android:layout_width="@dimen/admin_topbar_btn_size"
            android:layout_height="@dimen/admin_topbar_btn_size"
            android:padding="@dimen/admin_topbar_btn_padding"
            android:src="@drawable/ic_notification"
            android:background="@drawable/bg_badge_green"
            android:contentDescription="Notifications"
            app:tint="#2E7D32" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/text_hint" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/admin_nav_content_margin_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/admin_padding">

            <!-- Summary Cards: Stock, Orders, Alerts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/admin_section_margin_top">

                <!-- Stock Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/admin_card_gap"
                    app:cardCornerRadius="@dimen/admin_card_corner"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/admin_card_padding">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STOCK"
                            android:textSize="@dimen/admin_card_label_size"
                            android:textColor="#888888"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/tvStock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="@dimen/admin_card_value_size"
                            android:textStyle="bold"
                            android:textColor="#222222" />

                        <TextView
                            android:id="@+id/tvStockChange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading…"
                            android:textSize="@dimen/admin_card_change_size"
                            android:textColor="#4CAF50" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Orders Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/admin_card_gap"
                    app:cardCornerRadius="@dimen/admin_card_corner"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/admin_card_padding">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ORDERS"
                            android:textSize="@dimen/admin_card_label_size"
                            android:textColor="#888888"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/tvOrders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="@dimen/admin_card_value_size"
                            android:textStyle="bold"
                            android:textColor="#222222" />

                        <TextView
                            android:id="@+id/tvOrdersChange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading…"
                            android:textSize="@dimen/admin_card_change_size"
                            android:textColor="#4CAF50" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Alerts Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/admin_card_corner"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/admin_card_padding">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ALERTS"
                            android:textSize="@dimen/admin_card_label_size"
                            android:textColor="#888888"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/tvAlerts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="@dimen/admin_card_value_size"
                            android:textStyle="bold"
                            android:textColor="#F44336" />

                        <TextView
                            android:id="@+id/tvAlertsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading…"
                            android:textSize="@dimen/admin_card_change_size"
                            android:textColor="#F44336" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Per-Product Summary Cards: Laing & Sinantol -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/admin_section_margin_top">

                <!-- Laing Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/admin_card_gap"
                    app:cardCornerRadius="@dimen/admin_card_corner"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/admin_card_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LAING"
                                android:textSize="@dimen/admin_card_label_size"
                                android:textColor="#888888"
                                android:textAllCaps="true"
                                android:letterSpacing="0.05" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvLaingStock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="@dimen/admin_card_value_size"
                            android:textStyle="bold"
                            android:textColor="#222222" />

                        <TextView
                            android:id="@+id/tvLaingBatches"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- Active Batches"
                            android:textSize="@dimen/admin_card_change_size"
                            android:textColor="#888888" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Sinantol Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/admin_card_corner"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/admin_card_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SINANTOL"
                                android:textSize="@dimen/admin_card_label_size"
                                android:textColor="#888888"
                                android:textAllCaps="true"
                                android:letterSpacing="0.05" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSinantolStock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="@dimen/admin_card_value_size"
                            android:textStyle="bold"
                            android:textColor="#222222" />

                        <TextView
                            android:id="@+id/tvSinantolBatches"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- Active Batches"
                            android:textSize="@dimen/admin_card_change_size"
                            android:textColor="#888888" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>



            <!-- Log New Batch Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogNewBatch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/admin_button_height"
                android:layout_marginBottom="@dimen/admin_section_margin_top"
                android:text="+ Log New Batch"
                android:textSize="@dimen/admin_button_text_size"
                android:textColor="@color/white"
                android:textAllCaps="false"
                app:backgroundTint="#4CAF50"
                app:cornerRadius="@dimen/admin_button_corner" />

            <!-- Stock by Variation Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="@dimen/admin_section_icon_size"
                    android:layout_height="@dimen/admin_section_icon_size"
                    android:src="@drawable/ic_batches"
                    app:tint="#888888"
                    android:contentDescription="Variations" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/admin_section_gap"
                    android:text="Stock by Variation"
                    android:textSize="@dimen/admin_section_title_size"
                    android:textStyle="bold"
                    android:textColor="#222222" />

            </LinearLayout>

            <!-- Stock By Variation RecyclerView (HORIZONTAL) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVariationsStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/admin_section_margin_top"
                android:clipToPadding="false" />

            <!-- Recent Batches Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/admin_section_margin_bottom">

                <ImageView
                    android:layout_width="@dimen/admin_section_icon_size"
                    android:layout_height="@dimen/admin_section_icon_size"
                    android:src="@drawable/ic_batches"
                    app:tint="#4CAF50"
                    android:contentDescription="Batches" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/admin_section_gap"
                    android:text="Recent Batches"
                    android:textSize="@dimen/admin_section_title_size"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:id="@+id/tvViewAllBatches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIEW ALL"
                    android:textSize="@dimen/admin_section_badge_size"
                    android:textColor="#4CAF50"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Recent Batches RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentBatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="@dimen/admin_rv_margin_bottom" />

            <!-- Confirm New Orders Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/admin_section_margin_bottom">

                <ImageView
                    android:layout_width="@dimen/admin_section_icon_size"
                    android:layout_height="@dimen/admin_section_icon_size"
                    android:src="@drawable/ic_orders"
                    app:tint="#4CAF50"
                    android:contentDescription="Orders" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/admin_section_gap"
                    android:text="Confirm New Orders"
                    android:textSize="@dimen/admin_section_title_size"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:id="@+id/tvPendingOrderCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 NEW"
                    android:textSize="@dimen/admin_section_badge_size"
                    android:textColor="#4CAF50"
                    android:background="@drawable/bg_badge_green"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

            </LinearLayout>

            <!-- Pending Orders RecyclerView (HORIZONTAL) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPendingOrders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/admin_rv_margin_bottom"
                android:clipToPadding="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>