<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/admin_padding">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/admin_section_margin_top">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="@dimen/admin_profile_size"
                    android:layout_height="@dimen/admin_profile_size"
                    android:src="@drawable/ic_profile_placeholder" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/admin_profile_margin_start">

                    <TextView
                        android:id="@+id/tvAdminName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aling Admin"
                        android:textSize="@dimen/admin_profile_name_size"
                        android:textStyle="bold"
                        android:textColor="#222222" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Store Owner"
                        android:textSize="@dimen/admin_profile_role_size"
                        android:textColor="#888888" />

                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/admin_notification_size"
                    android:layout_height="@dimen/admin_notification_size"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Search"
                    android:layout_marginEnd="12dp" />

                <ImageView
                    android:id="@+id/btnNotification"
                    android:layout_width="@dimen/admin_notification_size"
                    android:layout_height="@dimen/admin_notification_size"
                    android:src="@drawable/ic_notification"
                    android:contentDescription="Notifications" />

            </LinearLayout>

            <!-- Summary Cards: Stock, Orders, Alerts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/admin_section_margin_top">

                <!-- Stock Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/admin_card_gap"
                    app:cardCornerRadius="@dimen/admin_card_corner"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/admin_card_padding">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STOCK"
                            android:textSize="@dimen/admin_card_label_size"
                            android:textColor="#888888"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/tvStock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="@dimen/admin_card_value_size"
                            android:textStyle="bold"
                            android:textColor="#222222" />

                        <TextView
                            android:id="@+id/tvStockChange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading…"
                            android:textSize="@dimen/admin_card_change_size"
                            android:textColor="#4CAF50" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Orders Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/admin_card_gap"
                    app:cardCornerRadius="@dimen/admin_card_corner"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/admin_card_padding">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ORDERS"
                            android:textSize="@dimen/admin_card_label_size"
                            android:textColor="#888888"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/tvOrders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="@dimen/admin_card_value_size"
                            android:textStyle="bold"
                            android:textColor="#222222" />

                        <TextView
                            android:id="@+id/tvOrdersChange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading…"
                            android:textSize="@dimen/admin_card_change_size"
                            android:textColor="#4CAF50" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Alerts Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/admin_card_corner"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/admin_card_padding">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ALERTS"
                            android:textSize="@dimen/admin_card_label_size"
                            android:textColor="#888888"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/tvAlerts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="@dimen/admin_card_value_size"
                            android:textStyle="bold"
                            android:textColor="#F44336" />

                        <TextView
                            android:id="@+id/tvAlertsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading…"
                            android:textSize="@dimen/admin_card_change_size"
                            android:textColor="#F44336" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Log New Batch Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogNewBatch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/admin_button_height"
                android:layout_marginBottom="@dimen/admin_section_margin_top"
                android:text="+ Log New Batch"
                android:textSize="@dimen/admin_button_text_size"
                android:textColor="@color/white"
                android:textAllCaps="false"
                app:backgroundTint="#4CAF50"
                app:cornerRadius="@dimen/admin_button_corner" />

            <!-- Recent Batches Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/admin_section_margin_bottom">

                <ImageView
                    android:layout_width="@dimen/admin_section_icon_size"
                    android:layout_height="@dimen/admin_section_icon_size"
                    android:src="@drawable/ic_batches"
                    app:tint="#4CAF50"
                    android:contentDescription="Batches" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/admin_section_gap"
                    android:text="Recent Batches (FIFO)"
                    android:textSize="@dimen/admin_section_title_size"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:id="@+id/tvViewAllBatches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIEW ALL"
                    android:textSize="@dimen/admin_section_badge_size"
                    android:textColor="#4CAF50"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Recent Batches RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentBatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="@dimen/admin_rv_margin_bottom" />

            <!-- Confirm New Orders Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/admin_section_margin_bottom">

                <ImageView
                    android:layout_width="@dimen/admin_section_icon_size"
                    android:layout_height="@dimen/admin_section_icon_size"
                    android:src="@drawable/ic_orders"
                    app:tint="#4CAF50"
                    android:contentDescription="Orders" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/admin_section_gap"
                    android:text="Confirm New Orders"
                    android:textSize="@dimen/admin_section_title_size"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:id="@+id/tvPendingOrderCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 NEW"
                    android:textSize="@dimen/admin_section_badge_size"
                    android:textColor="#4CAF50"
                    android:background="@drawable/bg_badge_green"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

            </LinearLayout>

            <!-- Pending Orders RecyclerView (HORIZONTAL) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPendingOrders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/admin_rv_margin_bottom"
                android:clipToPadding="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB - Add New Batch -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="25dp"
        android:contentDescription="Add New Batch"
        android:src="@drawable/ic_add_batches"
        app:backgroundTint="@color/white"
        app:borderWidth="0dp"
        app:elevation="6dp"
        app:fabCustomSize="56dp"
        app:maxImageSize="24dp"
        app:tint="#4CAF50" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>