<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- ═══ Custom Top Bar ═══ -->
    <LinearLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/admin_padding"
        android:background="@color/white"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/admin_topbar_btn_size"
            android:layout_height="@dimen/admin_topbar_btn_size"
            android:padding="@dimen/admin_topbar_btn_padding"
            android:src="@drawable/ic_cart"
            android:background="@drawable/bg_badge_green"
            app:tint="@color/green_primary"
            android:layout_marginEnd="@dimen/admin_topbar_icon_gap_large" />

        <TextView
            android:id="@+id/tvCartTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Cart"
            android:textSize="@dimen/admin_topbar_title_large"
            android:textColor="#222222"
            android:fontFamily="@font/inter_bold" />

        <TextView
            android:id="@+id/tvCartItemCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            tools:text="3 Items"
            android:textSize="13sp"
            android:textColor="#888888"
            android:fontFamily="@font/inter_medium" />

        <ImageView
            android:id="@+id/ivNotification"
            android:layout_width="@dimen/admin_topbar_btn_size"
            android:layout_height="@dimen/admin_topbar_btn_size"
            android:padding="@dimen/admin_topbar_btn_padding"
            android:src="@drawable/ic_notification"
            android:background="@drawable/bg_badge_green"
            app:tint="@color/green_primary"
            android:contentDescription="Notifications" />

    </LinearLayout>

    <View
        android:id="@+id/dividerTopBar"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/text_hint"
        app:layout_constraintTop_toBottomOf="@id/clTopBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/dividerTopBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Items List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCartItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_cart_product" />

            <!-- 2. Add More Items Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddMoreItems"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="+ Add more items"
                android:textAllCaps="false"
                android:textColor="@color/green_primary"
                android:fontFamily="@font/inter_semibold"
                app:strokeColor="@color/green_primary"
                app:cornerRadius="12dp" />

            <!-- 3. Delivery Address Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery Address"
                android:textColor="#222222"
                android:textSize="15sp"
                android:fontFamily="@font/inter_semibold"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAddress"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="@color/green_primary"
                app:hintEnabled="false"
                app:endIconMode="custom"
                app:endIconDrawable="@android:drawable/ic_dialog_map"
                app:endIconTint="@color/green_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select your delivery location"
                    android:inputType="textPostalAddress"
                    android:focusable="false"
                    android:clickable="true"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 4. Summary Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order Summary"
                        android:textColor="#222222"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Subtotal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subtotal"
                            android:textColor="#666666"
                            android:fontFamily="@font/inter_regular" />
                        <TextView
                            android:id="@+id/tvSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="₱360.00"
                            android:textColor="#222222"
                            android:fontFamily="@font/inter_semibold" />
                    </LinearLayout>

                    <!-- Delivery Fee -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:id="@+id/tvDeliveryFeeLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Delivery Fee"
                            android:textColor="#666666"
                            android:fontFamily="@font/inter_regular" />
                        <TextView
                            android:id="@+id/tvDeliveryFee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="₱50.00"
                            android:textColor="#222222"
                            android:fontFamily="@font/inter_semibold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginBottom="16dp" />

                    <!-- Total Amount -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="24dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total Amount"
                            android:textColor="#222222"
                            android:textSize="16sp"
                            android:fontFamily="@font/inter_bold" />
                        <TextView
                            android:id="@+id/tvTotalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="₱410.00"
                            android:textSize="20sp"
                            android:textColor="@color/user_price_green"
                            android:fontFamily="@font/inter_bold" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlaceOrder"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Place Order"
                        app:cornerRadius="12dp"
                        android:fontFamily="@font/inter_bold"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:backgroundTint="@color/green_primary" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
