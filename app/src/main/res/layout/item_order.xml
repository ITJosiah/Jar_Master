<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/admin_order_card_width"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_order_card"
    android:padding="@dimen/admin_item_padding"
    android:layout_marginEnd="@dimen/admin_order_card_margin_end"
    android:elevation="0dp">

    <!-- Profile Row: Avatar + Name + Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/admin_item_gap_large">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgCustomerAvatar"
            android:layout_width="@dimen/admin_order_avatar_size"
            android:layout_height="@dimen/admin_order_avatar_size"
            android:src="@drawable/ic_profile_placeholder"
            android:layout_marginEnd="@dimen/admin_order_avatar_margin_end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maria Santos"
                android:textSize="@dimen/admin_item_customer_name_size"
                android:textStyle="bold"
                android:textColor="#222222"
                android:fontFamily="@font/inter_semibold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvOrderTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 mins ago"
                android:textSize="@dimen/admin_item_time_size"
                android:textColor="#4CAF50" />

        </LinearLayout>

    </LinearLayout>

    <!-- Order Items -->
    <TextView
        android:id="@+id/tvOrderItems"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3x Spicy Laing (250g)"
        android:textSize="@dimen/admin_item_detail_size"
        android:textColor="#555555"
        android:layout_marginBottom="@dimen/admin_item_gap_small"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Price -->
    <TextView
        android:id="@+id/tvOrderTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₱540.00"
        android:textSize="@dimen/admin_item_total_size"
        android:textStyle="bold"
        android:fontFamily="@font/inter_bold"
        android:textColor="#222222"
        android:layout_marginBottom="@dimen/admin_item_gap_large" />

    <!-- Action Buttons: Decline + Confirm -->
    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDecline"
            android:layout_width="0dp"
            android:layout_height="@dimen/admin_order_button_height"
            android:layout_weight="1"
            android:text="Decline"
            android:textSize="@dimen/admin_item_button_text_size"
            android:textColor="#555555"
            android:textStyle="bold"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:background="@drawable/bg_btn_decline"
            android:layout_marginEnd="@dimen/admin_item_button_gap" />

        <TextView
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="@dimen/admin_order_button_height"
            android:layout_weight="1"
            android:text="Confirm"
            android:textSize="@dimen/admin_item_button_text_size"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:background="@drawable/bg_btn_confirm" />

    </LinearLayout>

</LinearLayout>
