<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/admin_dialog_padding">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Log New Batch"
        android:textSize="@dimen/admin_dialog_title_size"
        android:textStyle="bold"
        android:fontFamily="@font/inter_semibold"
        android:textColor="#222222"
        android:layout_marginBottom="@dimen/admin_dialog_title_gap" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add a new product batch to inventory"
        android:textSize="@dimen/admin_dialog_subtitle_size"
        android:textColor="#888888"
        android:layout_marginBottom="@dimen/admin_dialog_subtitle_margin_bottom" />

    <!-- Batch Name -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilBatchName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/admin_dialog_field_margin_bottom"
        app:boxCornerRadiusTopStart="@dimen/admin_dialog_field_corner"
        app:boxCornerRadiusTopEnd="@dimen/admin_dialog_field_corner"
        app:boxCornerRadiusBottomStart="@dimen/admin_dialog_field_corner"
        app:boxCornerRadiusBottomEnd="@dimen/admin_dialog_field_corner"
        android:hint="Product Name"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBatchName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/admin_dialog_input_size"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Quantity -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/admin_dialog_field_margin_bottom"
        app:boxCornerRadiusTopStart="@dimen/admin_dialog_field_corner"
        app:boxCornerRadiusTopEnd="@dimen/admin_dialog_field_corner"
        app:boxCornerRadiusBottomStart="@dimen/admin_dialog_field_corner"
        app:boxCornerRadiusBottomEnd="@dimen/admin_dialog_field_corner"
        android:hint="Quantity (units)"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/admin_dialog_input_size"
            android:inputType="number" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Expiry Date -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilExpiryDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/admin_dialog_field_margin_bottom"
        app:boxCornerRadiusTopStart="@dimen/admin_dialog_field_corner"
        app:boxCornerRadiusTopEnd="@dimen/admin_dialog_field_corner"
        app:boxCornerRadiusBottomStart="@dimen/admin_dialog_field_corner"
        app:boxCornerRadiusBottomEnd="@dimen/admin_dialog_field_corner"
        android:hint="Expiry Date"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_calendar"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/admin_dialog_input_size"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Status Spinner -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status"
        android:textSize="@dimen/admin_dialog_label_size"
        android:textColor="#888888"
        android:layout_marginBottom="@dimen/admin_dialog_label_margin_bottom" />

    <Spinner
        android:id="@+id/spinnerStatus"
        android:layout_width="match_parent"
        android:layout_height="@dimen/admin_dialog_spinner_height"
        android:background="@drawable/bg_tab_inactive"
        android:padding="@dimen/admin_dialog_spinner_padding"
        android:layout_marginBottom="@dimen/admin_dialog_subtitle_margin_bottom" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/admin_dialog_button_height"
            android:layout_weight="1"
            android:text="Cancel"
            android:textSize="@dimen/admin_dialog_input_size"
            android:textColor="#555555"
            android:textAllCaps="false"
            android:layout_marginEnd="@dimen/admin_dialog_button_gap"
            app:backgroundTint="#F5F5F5"
            app:cornerRadius="@dimen/admin_dialog_field_corner" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveBatch"
            android:layout_width="0dp"
            android:layout_height="@dimen/admin_dialog_button_height"
            android:layout_weight="1"
            android:text="Save Batch"
            android:textSize="@dimen/admin_dialog_input_size"
            android:textColor="@color/white"
            android:textAllCaps="false"
            app:backgroundTint="#4CAF50"
            app:cornerRadius="@dimen/admin_dialog_field_corner" />

    </LinearLayout>

</LinearLayout>
