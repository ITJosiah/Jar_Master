<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/login_horizontal_padding"
        android:paddingEnd="@dimen/login_horizontal_padding"
        android:paddingTop="@dimen/login_top_padding"
        android:paddingBottom="@dimen/login_bottom_padding">

        <!-- App Logo -->
        <ImageView
            android:id="@+id/ivRegisterLogo"
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:src="@drawable/ic_aling_logo"
            android:contentDescription="App Logo"
            android:padding="@dimen/logo_padding"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- App Name -->
        <TextView
            android:id="@+id/tvRegisterAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/app_short_name"
            android:textSize="@dimen/text_title"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@color/text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivRegisterLogo" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvRegisterSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/register_subtitle"
            android:textSize="@dimen/text_subtitle"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRegisterAppName" />

        <!-- ── Full Name Label ── -->
        <TextView
            android:id="@+id/tvFullNameLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_section"
            android:text="@string/label_full_name"
            android:textSize="@dimen/text_label"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRegisterSubtitle" />

        <!-- ── Full Name Input ── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFullName"
            style="@style/LoginInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:boxCornerRadiusBottomEnd="@dimen/login_input_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/login_input_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/login_input_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/login_input_corner_radius"
            android:layout_marginTop="@dimen/margin_xsmall"
            app:startIconDrawable="@drawable/ic_person"
            app:boxStrokeColor="@color/input_stroke_selector"
            app:startIconTint="@color/text_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFullNameLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_full_name"
                android:inputType="textPersonName|textCapWords"
                android:textSize="@dimen/text_input"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:paddingTop="@dimen/input_padding_vertical"
                android:paddingBottom="@dimen/input_padding_vertical"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Email Label ── -->
        <TextView
            android:id="@+id/tvEmailLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:text="@string/label_email"
            android:textSize="@dimen/text_label"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilFullName" />

        <!-- ── Email Input ── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/LoginInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_xsmall"
            app:boxCornerRadiusBottomEnd="@dimen/login_input_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/login_input_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/login_input_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/login_input_corner_radius"
            app:boxStrokeColor="@color/input_stroke_selector"
            app:startIconDrawable="@drawable/ic_email"
            app:startIconTint="@color/text_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEmailLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                android:textSize="@dimen/text_input"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:paddingTop="@dimen/input_padding_vertical"
                android:paddingBottom="@dimen/input_padding_vertical"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Password Label ── -->
        <TextView
            android:id="@+id/tvRegPasswordLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:text="@string/label_password"
            android:textSize="@dimen/text_label"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilEmail" />

        <!-- ── Password Input ── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRegPassword"
            style="@style/LoginInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_xsmall"
            app:boxCornerRadiusBottomEnd="@dimen/login_input_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/login_input_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/login_input_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/login_input_corner_radius"
            app:boxStrokeColor="@color/input_stroke_selector"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="@color/text_hint"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/text_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRegPasswordLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:textSize="@dimen/text_input"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:paddingTop="@dimen/input_padding_vertical"
                android:paddingBottom="@dimen/input_padding_vertical"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Confirm Password Label ── -->
        <TextView
            android:id="@+id/tvConfirmPasswordLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:text="@string/label_confirm_password"
            android:textSize="@dimen/text_label"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilRegPassword" />

        <!-- ── Confirm Password Input ── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirmPassword"
            style="@style/LoginInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_xsmall"
            app:boxCornerRadiusBottomEnd="@dimen/login_input_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/login_input_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/login_input_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/login_input_corner_radius"
            app:boxStrokeColor="@color/input_stroke_selector"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="@color/text_hint"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/text_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvConfirmPasswordLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_confirm_password"
                android:inputType="textPassword"
                android:textSize="@dimen/text_input"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:paddingTop="@dimen/input_padding_vertical"
                android:paddingBottom="@dimen/input_padding_vertical"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Create Account Button ── -->
        <Button
            android:id="@+id/btnCreateAccount"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/margin_large"
            android:text="@string/create_account"
            android:textSize="@dimen/text_button"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@color/white"
            android:backgroundTint="@color/green_primary"
            android:stateListAnimator="@null"
            app:cornerRadius="@dimen/button_corner_radius"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilConfirmPassword" />

        <!-- ── OAuth Divider ── -->
        <LinearLayout
            android:id="@+id/llOAuthDivider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnCreateAccount">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/inter_regular"
                android:text="@string/or_sign_up_with"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_small" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider_color" />
        </LinearLayout>

        <!-- ── OAuth Buttons Row ── -->
        <LinearLayout
            android:id="@+id/llOAuthButtons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llOAuthDivider">

            <!-- Google Button -->
            <LinearLayout
                android:id="@+id/btnGoogle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_oauth_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/continue_google"
                    android:src="@drawable/ic_google" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/continue_google"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <!-- Facebook Button -->
            <LinearLayout
                android:id="@+id/btnFacebook"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_oauth_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/continue_facebook"
                    android:src="@drawable/ic_facebook" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/continue_facebook"
                    android:textColor="@color/facebook_blue"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Already have account row ── -->
        <LinearLayout
            android:id="@+id/llLoginRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llOAuthButtons">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/already_have_account"
                android:textSize="@dimen/text_small"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvLogIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="5dp"
                android:text="@string/log_in"
                android:textSize="@dimen/text_small"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/green_primary"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- ── Terms & Privacy Footer ── -->
        <TextView
            android:id="@+id/tvTerms"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:text="@string/terms_text"
            android:textSize="@dimen/text_footer"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/text_hint"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llLoginRow" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>