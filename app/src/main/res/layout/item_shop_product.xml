<?xml version="1.0" encoding="utf-8"?>
<!-- Single product card for the 2-column shop grid -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/user_product_card_corner"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    android:layout_margin="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Product Image Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/user_product_image_height"
            android:clipChildren="false">

            <!-- Product Image -->
            <ImageView
                android:id="@+id/ivProductImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_laing" />

            <!-- Favorite Heart Button -->
            <ImageView
                android:id="@+id/ivFavorite"
                android:layout_width="@dimen/user_product_heart_size"
                android:layout_height="@dimen/user_product_heart_size"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_heart_circle"
                android:padding="6dp"
                android:src="@drawable/saved_ic"
                app:tint="@color/user_heart_red"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Add to favorites" />

        </FrameLayout>

        <!-- Product Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/user_product_card_padding">

            <!-- Product Name -->
            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/user_product_name_size"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/inter_semibold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Classic Laing" />

            <!-- Quantity / Description -->
            <TextView
                android:id="@+id/tvQuantityLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="@dimen/user_product_quantity_size"
                android:textColor="@color/user_quantity_text"
                android:fontFamily="@font/inter_regular"
                android:maxLines="1"
                android:textAllCaps="true"
                android:letterSpacing="0.04"
                tools:text="250G GLASS JAR" />

            <!-- Price Row: ₱ price + add button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Price -->
                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/user_product_price_size"
                    android:textColor="@color/user_price_green"
                    android:fontFamily="@font/inter_bold"
                    tools:text="₱180.00" />

                <!-- Add to Cart Button -->
                <ImageView
                    android:id="@+id/ivAddToCart"
                    android:layout_width="@dimen/user_product_add_btn_size"
                    android:layout_height="@dimen/user_product_add_btn_size"
                    android:background="@drawable/bg_add_btn"
                    android:src="@drawable/ic_add"
                    android:padding="6dp"
                    app:tint="@color/white"
                    android:scaleType="centerInside"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Add to cart" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
