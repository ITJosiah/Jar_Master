<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/bg_dialog_rounded">

    <!-- Handle -->
    <View
        android:id="@+id/handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#E0E0E0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- Product Image -->
    <ImageView
        android:id="@+id/ivProductImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerCrop"
        android:background="#F0F0F0"
        app:layout_constraintTop_toBottomOf="@id/handle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Price Section -->
    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        tools:text="₱175.00 - ₱230.00"
        android:textColor="@color/user_price_green"
        android:textSize="20sp"
        android:fontFamily="@font/inter_bold"
        app:layout_constraintTop_toBottomOf="@id/handle"
        app:layout_constraintStart_toEndOf="@id/ivProductImage"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Stock text -->
    <TextView
        android:id="@+id/tvStockLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        tools:text="Stock: 120"
        android:textColor="#666666"
        android:textSize="14sp"
        android:fontFamily="@font/inter_regular"
        app:layout_constraintTop_toBottomOf="@id/tvPrice"
        app:layout_constraintStart_toEndOf="@id/ivProductImage"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Variations hint -->
    <TextView
        android:id="@+id/tvSelectHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:text="Please select variations"
        android:textColor="#222222"
        android:textSize="14sp"
        android:fontFamily="@font/inter_medium"
        app:layout_constraintTop_toBottomOf="@id/tvStockLabel"
        app:layout_constraintStart_toEndOf="@id/ivProductImage"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/divider1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/ivProductImage" />

    <!-- MEAT INGREDIENT Selection -->
    <TextView
        android:id="@+id/tvMeatLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MEAT INGREDIENT"
        android:textColor="#222222"
        android:fontFamily="@font/inter_bold"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/divider1"
        app:layout_constraintStart_toStartOf="parent" />

    <RadioGroup
        android:id="@+id/rgMeatGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvMeatLabel">

        <RadioButton
            android:id="@+id/rbMeatPork"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Pork"
            android:background="@drawable/bg_variation_selector"
            android:button="@null"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginEnd="12dp"
            android:textColor="@color/variation_text_color"
            android:fontFamily="@font/inter_medium"
            android:textSize="14sp"
            android:gravity="center" />

        <RadioButton
            android:id="@+id/rbMeatTinapa"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Tinapa"
            android:background="@drawable/bg_variation_selector"
            android:button="@null"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/variation_text_color"
            android:fontFamily="@font/inter_medium"
            android:textSize="14sp"
            android:gravity="center" />
    </RadioGroup>

    <View
        android:id="@+id/divider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/rgMeatGroup" />

    <!-- SIZE Selection -->
    <TextView
        android:id="@+id/tvSizeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SIZE"
        android:textColor="#222222"
        android:fontFamily="@font/inter_bold"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/divider2"
        app:layout_constraintStart_toStartOf="parent" />

    <RadioGroup
        android:id="@+id/rgSizeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvSizeLabel">

        <RadioButton
            android:id="@+id/rbSize190g"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="190g"
            android:background="@drawable/bg_variation_selector"
            android:button="@null"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginEnd="12dp"
            android:textColor="@color/variation_text_color"
            android:fontFamily="@font/inter_medium"
            android:textSize="14sp"
            android:gravity="center" />

        <RadioButton
            android:id="@+id/rbSize320g"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="320g"
            android:background="@drawable/bg_variation_selector"
            android:button="@null"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/variation_text_color"
            android:fontFamily="@font/inter_medium"
            android:textSize="14sp"
            android:gravity="center" />
    </RadioGroup>

    <View
        android:id="@+id/divider3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/rgSizeGroup" />

    <!-- QUANTITY Selection -->
    <TextView
        android:id="@+id/tvQuantityLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quantity"
        android:textColor="#222222"
        android:fontFamily="@font/inter_regular"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/divider3"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/llQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_quantity_stepper"
        android:padding="2dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/divider3"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnQtyMinus"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_minus"
            android:padding="6dp"
            app:tint="@color/green_primary"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <EditText
            android:id="@+id/etQuantity"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/inter_semibold"
            android:textSize="14sp"
            android:inputType="number"
            android:background="@null"
            android:maxLines="1"
            android:selectAllOnFocus="true" />

        <ImageView
            android:id="@+id/btnQtyPlus"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_add"
            app:tint="@color/green_primary"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddToCart"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Add to Cart"
        android:layout_marginTop="32dp"
        app:cornerRadius="4dp"
        android:fontFamily="@font/inter_bold"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="@color/green_primary"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tvQuantityLabel" />

</androidx.constraintlayout.widget.ConstraintLayout>
