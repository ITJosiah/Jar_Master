<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/admin_padding"
        android:background="@color/white">

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="@dimen/admin_topbar_btn_size"
            android:layout_height="@dimen/admin_topbar_btn_size"
            android:padding="@dimen/admin_topbar_btn_padding"
            android:src="@drawable/ic_orders"
            android:background="@drawable/bg_badge_green"
            android:contentDescription="Menu"
            app:tint="#2E7D32"
            android:layout_marginEnd="@dimen/admin_topbar_icon_gap_large" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Orders"
            android:textSize="@dimen/admin_topbar_title_large"
            android:textStyle="bold"
            android:textColor="#222222" />

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="@dimen/admin_topbar_btn_size"
            android:layout_height="@dimen/admin_topbar_btn_size"
            android:padding="@dimen/admin_topbar_btn_padding"
            android:src="@drawable/ic_search"
            android:background="@drawable/bg_badge_green"
            android:contentDescription="Search"
            app:tint="#2E7D32"
            android:layout_marginEnd="@dimen/admin_topbar_icon_gap" />

        <ImageView
            android:id="@+id/btnNotification"
            android:layout_width="@dimen/admin_topbar_btn_size"
            android:layout_height="@dimen/admin_topbar_btn_size"
            android:padding="@dimen/admin_topbar_btn_padding"
            android:src="@drawable/ic_notification"
            android:background="@drawable/bg_badge_green"
            android:contentDescription="Notifications"
            app:tint="#2E7D32" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/text_hint" />

    <!-- TabLayout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingTop="@dimen/admin_section_gap"
        android:paddingBottom="@dimen/admin_dialog_title_gap"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabTextColor="#78909C"
        app:tabSelectedTextColor="#4CAF50"
        app:tabIndicatorColor="#4CAF50"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="@dimen/admin_item_gap_small"
        app:tabRippleColor="@null"
        app:tabTextAppearance="@style/CustomTabTextStyle" />

    <!-- Orders list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOrders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/admin_rv_padding_h"
        android:paddingEnd="@dimen/admin_rv_padding_h"
        android:paddingTop="@dimen/margin_small"
        android:paddingBottom="@dimen/admin_rv_padding_bottom"
        android:clipToPadding="false" />
</LinearLayout>
