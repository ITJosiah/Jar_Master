<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected state — green border + light green background -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#3DBA5F" />
            <solid android:color="#D6F5E0" />
        </shape>
    </item>

    <!-- Default state — gray border + white background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#E0E0E0" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

</selector>