<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/aling_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/aling_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aling_Jar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".auth.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Aling.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait">
        </activity>

        <activity
            android:name=".admin.AdminActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".user.UserActivity"
            android:exported="false"
            android:screenOrientation="portrait" />


        <activity
            android:name=".auth.SignupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".auth.EmailVerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".user.profile.EditAccountActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".user.profile.ChangePasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".user.profile.AboutAlingActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".user.notifications.NotificationsActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".auth.SignupSuccessActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".utils.MapPickerActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>



    </application>

</manifest>