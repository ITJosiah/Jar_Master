<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/aling_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/aling_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aling_Jar">

        <activity
            android:name=".actvities.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Aling.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".actvities.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".actvities.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait">
        </activity>


        <activity
            android:name=".actvities.SignupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".actvities.EmailVerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".actvities.SignupSuccessActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

    </application>

</manifest>